generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  ERROR
}

enum TransactionType {
  PAYABLE
  RECEIVABLE
}

enum TransactionStatus {
  PENDING
  SETTLED
}

enum SourceType {
  DRIVE
  LOCAL
}

enum ImportMode {
  AUTO_FOLDER
  MANUAL_UPLOAD
}

enum DriveSyncRunTrigger {
  MANUAL
  SCHEDULED
}

enum DriveSyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  SKIPPED_LOCKED
}

enum DriveSyncExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  SKIPPED_ALREADY_PROCESSED
  SKIPPED_LOCKED
  DEFERRED_STABILITY
  FAILED
}

enum SourceFileKind {
  OPERATIONAL
  FINES
  FINANCIAL
  WORKBOOK
  UNKNOWN
}

enum ImportBatchKind {
  LEGACY_TRANSACTION
  OPERATIONAL_SNAPSHOT
  FINANCIAL_LEDGER
  FINE_LEDGER
  WORKBOOK_MULTI_SHEET
}

enum ImportPipelineStatus {
  UPLOADED
  PARSED
  VALIDATED
  REJECTED
  PUBLISHED
}

enum ImportRecordType {
  OPERATIONAL_SNAPSHOT
  FINANCIAL_ENTRY
  FINE_RECORD
  FINE_RESPONSIBILITY
  RECONCILIATION
  UNSUPPORTED
}

enum ImportRowKind {
  DETAIL
  SECTION_LABEL
  SUBTOTAL
  RECONCILIATION
  UNKNOWN
}

enum FinancialEntryDomain {
  REVENUE
  EXPENSE
  INVESTMENT
}

enum FinancialEntryDirection {
  INFLOW
  OUTFLOW
}

enum FinePaymentState {
  UNKNOWN
  UNPAID
  PARTIAL
  PAID
  CONTESTED
  CANCELLED
}

enum ResponsibilityType {
  UNKNOWN
  COMPANY
  OWNER
  DRIVER
  LEGAL
  THIRD_PARTY
}

enum OperationalPaymentState {
  UNKNOWN
  UNPAID
  PARTIAL
  PAID
  OVERPAID
}

enum MatchType {
  EXACT
  CONTAINS
  REGEX
}

enum NormalizationScope {
  EXPENSE
  INCOME
  BOTH
}

enum UserRole {
  ADMIN
  INVESTOR
}

enum CategorySource {
  RAW
  NORMALIZED
  MANUAL
}

model SourceFile {
  id                   String                @id @default(cuid())
  driveFileId          String                @unique
  importBatchId        String?
  name                 String
  parentFolderId       String?
  modifiedTime         DateTime
  checksum             String?
  processedAt          DateTime?
  status               ProcessingStatus      @default(PENDING)
  errorMessage         String?
  source               SourceType            @default(LOCAL)
  importMode           ImportMode            @default(AUTO_FOLDER)
  kind                 SourceFileKind        @default(UNKNOWN)
  originalPath         String?
  totalRows            Int                   @default(0)
  importedRows         Int                   @default(0)
  skippedRows          Int                   @default(0)
  errorCount           Int                   @default(0)
  details              Json?
  importBatch          ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  transactions         Transaction[]
  operationalSnapshots OperationalSnapshot[]
  financialEntries     FinancialEntry[]
  fineRecords          FineRecord[]
  fineResponsibilities FineResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importBatchId])
  @@index([importMode])
  @@index([kind])
  @@index([processedAt])
}

model Transaction {
  id   String          @id @default(cuid())
  type TransactionType

  // Relacionamento com o arquivo de origem
  sourceFileId String
  sourceFile   SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  // Campos de Negócio
  externalId   String? // Número do Lançamento
  rowHash      String? @unique // Hash para deduplicação (sourceFileHash + sheet + row + date + amount + desc)
  category     String?
  counterparty String? // Fornecedor ou Cliente
  description  String?
  unit         String? // Unidade

  // Datas
  plannedDate DateTime? // Data Prevista / Vencimento Original
  dueDate     DateTime? // Data Vencimento (considerada para fluxo)
  actualDate  DateTime? // Data Pagamento / Recebimento

  // Valores
  plannedAmount Decimal  @db.Decimal(12, 2) // Valor Original / Previsto
  actualAmount  Decimal? @db.Decimal(12, 2) // Valor Pago / Baixado
  feesInterest  Decimal? @db.Decimal(12, 2) // Juros/Multa
  feesFine      Decimal? @db.Decimal(12, 2)
  discount      Decimal? @db.Decimal(12, 2)
  grossAmount   Decimal? @db.Decimal(12, 2) // Valor Bruto

  status TransactionStatus @default(PENDING)

  rawJson Json? // Dados originais da linha para debug

  // Campos de normalização de categoria
  rawLabel           String? // Texto usado para matching de regras (derivado do import)
  categorySource     CategorySource             @default(RAW)
  normalizedByRuleId String? // FK para regra que categorizou
  normalizedByRule   CategoryNormalizationRule? @relation(fields: [normalizedByRuleId], references: [id], onDelete: SetNull)
  normalizedAt       DateTime? // Quando a normalização foi aplicada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalId])
  @@index([type, dueDate])
  @@index([type, actualDate])
  @@index([sourceFileId])
  @@index([categorySource])
  @@index([normalizedByRuleId])
}

// ============================================================================
// CATEGORY NORMALIZATION
// ============================================================================

model CategoryNormalizationRule {
  id          String             @id @default(cuid())
  fromPattern String // Padrão a ser buscado (texto ou regex)
  matchType   MatchType          @default(CONTAINS)
  scope       NormalizationScope @default(BOTH)
  toCategory  String // Categoria de destino (nome padronizado)
  priority    Int                @default(0)
  active      Boolean            @default(true)

  // Auditoria
  transactions Transaction[] // Transações normalizadas por esta regra

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, scope])
  @@index([priority])
}

model ImportBatch {
  id                   String                @id @default(cuid())
  batchKey             String                @unique
  kind                 ImportBatchKind       @default(OPERATIONAL_SNAPSHOT)
  status               ProcessingStatus      @default(PENDING)
  pipelineStatus       ImportPipelineStatus  @default(UPLOADED)
  startedAt            DateTime              @default(now())
  parsedAt             DateTime?
  validatedAt          DateTime?
  rejectedAt           DateTime?
  publishedAt          DateTime?
  completedAt          DateTime?
  uploadCount          Int                   @default(0)
  fileCount            Int                   @default(0)
  rowCount             Int                   @default(0)
  normalizedRowCount   Int                   @default(0)
  rejectedRowCount     Int                   @default(0)
  publishedRowCount    Int                   @default(0)
  templateVersion      String?
  errorMessage         String?
  validationMessages   Json?
  details              Json?
  importFiles          ImportFile[]
  rawRows              ImportRowRaw[]        @relation("ImportBatchRawRows")
  normalizedRows       ImportRowNormalized[] @relation("ImportBatchNormalizedRows")
  sourceFiles          SourceFile[]
  operationalSnapshots OperationalSnapshot[]
  financialEntries     FinancialEntry[]
  fineRecords          FineRecord[]
  fineResponsibilities FineResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([pipelineStatus])
  @@index([startedAt])
}

model ImportFile {
  id                 String                @id @default(cuid())
  importBatchId      String
  driveImportFolderId String?
  status             ImportPipelineStatus  @default(UPLOADED)
  name               String
  checksum           String                @unique
  externalFileId     String?
  externalModifiedTime DateTime?
  fileExtension      String?
  kind               SourceFileKind        @default(UNKNOWN)
  importMode         ImportMode            @default(MANUAL_UPLOAD)
  source             SourceType            @default(LOCAL)
  templateVersion    String?
  originalPath       String?
  uploadedAt         DateTime              @default(now())
  parsedAt           DateTime?
  validatedAt        DateTime?
  rejectedAt         DateTime?
  publishedAt        DateTime?
  totalRows          Int                   @default(0)
  parsedRows         Int                   @default(0)
  validatedRows      Int                   @default(0)
  rejectedRows       Int                   @default(0)
  publishedRows      Int                   @default(0)
  warningCount       Int                   @default(0)
  errorCount         Int                   @default(0)
  sourceSheets       Json?
  validationMessages Json?
  details            Json?
  importBatch        ImportBatch           @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  driveImportFolder  DriveImportFolder?    @relation(fields: [driveImportFolderId], references: [id], onDelete: SetNull)
  rawRows            ImportRowRaw[]        @relation("ImportFileRawRows")
  normalizedRows     ImportRowNormalized[] @relation("ImportFileNormalizedRows")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importBatchId])
  @@index([driveImportFolderId])
  @@index([status])
  @@index([kind])
  @@index([externalFileId])
  @@index([uploadedAt])
}

model DriveImportFolder {
  id                   String       @id @default(cuid())
  label                String
  folderId             String
  sharedDriveId        String?
  enabled              Boolean      @default(true)
  templateVersion      String?
  syncLeaseToken       String?
  syncLeaseExpiresAt   DateTime?
  lastScannedAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSeenModifiedTime DateTime?
  lastSeenFileId       String?
  consecutiveFailures  Int          @default(0)
  lastAlertedAt        DateTime?
  lastRunStatus        DriveSyncRunStatus?
  lastRunFinishedAt    DateTime?
  errorMessage         String?
  details              Json?
  importFiles          ImportFile[]
  syncRuns             DriveSyncRun[]
  syncExecutions       DriveSyncExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([folderId, sharedDriveId])
  @@index([enabled, updatedAt])
  @@index([syncLeaseExpiresAt])
}

model DriveSyncRun {
  id                  String             @id @default(cuid())
  driveImportFolderId String
  leaseToken          String
  trigger             DriveSyncRunTrigger @default(SCHEDULED)
  status              DriveSyncRunStatus @default(RUNNING)
  startedAt           DateTime           @default(now())
  completedAt         DateTime?
  filesDiscovered     Int                @default(0)
  filesImported       Int                @default(0)
  filesSkipped        Int                @default(0)
  filesErrored        Int                @default(0)
  filesDeferred       Int                @default(0)
  retryCount          Int                @default(0)
  alertCount          Int                @default(0)
  errorMessage        String?
  details             Json?
  driveImportFolder   DriveImportFolder  @relation(fields: [driveImportFolderId], references: [id], onDelete: Cascade)
  executions          DriveSyncExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driveImportFolderId, startedAt])
  @@index([status, startedAt])
}

model DriveSyncExecution {
  id                   String                   @id @default(cuid())
  driveImportFolderId  String
  driveSyncRunId       String?
  externalFileId       String
  externalModifiedTime DateTime
  fileName             String
  checksumHint         String?
  status               DriveSyncExecutionStatus @default(PENDING)
  leaseToken           String?
  leaseExpiresAt       DateTime?
  attempts             Int                      @default(0)
  retryCount           Int                      @default(0)
  stableAfter          DateTime?
  lastAttemptAt        DateTime?
  completedAt          DateTime?
  errorMessage         String?
  importBatchId        String?
  importFileId         String?
  details              Json?
  driveImportFolder    DriveImportFolder        @relation(fields: [driveImportFolderId], references: [id], onDelete: Cascade)
  driveSyncRun         DriveSyncRun?            @relation(fields: [driveSyncRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalFileId, externalModifiedTime])
  @@index([driveImportFolderId, status])
  @@index([driveSyncRunId])
  @@index([leaseExpiresAt])
}

model ImportRowRaw {
  id                 String               @id @default(cuid())
  importBatchId      String
  importFileId       String
  status             ImportPipelineStatus @default(PARSED)
  recordType         ImportRecordType
  rowKind            ImportRowKind        @default(DETAIL)
  sourceSheetName    String
  sourceRowNumber    Int
  headerFingerprint  String?
  rawLineKey         String               @unique
  dedupeKey          String?
  businessKey        String?
  rawPayload         Json
  validationMessages Json?
  errorMessage       String?
  importBatch        ImportBatch          @relation("ImportBatchRawRows", fields: [importBatchId], references: [id], onDelete: Cascade)
  importFile         ImportFile           @relation("ImportFileRawRows", fields: [importFileId], references: [id], onDelete: Cascade)
  normalizedRow      ImportRowNormalized?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([importFileId, sourceSheetName, sourceRowNumber])
  @@index([importBatchId])
  @@index([status])
  @@index([recordType])
  @@index([rowKind])
  @@index([dedupeKey])
  @@index([businessKey])
}

model ImportRowNormalized {
  id                   String               @id @default(cuid())
  importBatchId        String
  importFileId         String
  importRowRawId       String               @unique
  status               ImportPipelineStatus @default(VALIDATED)
  recordType           ImportRecordType
  rowKind              ImportRowKind        @default(DETAIL)
  sourceSheetName      String
  sourceRowNumber      Int
  normalizedLineKey    String               @unique
  dedupeKey            String?
  businessKey          String?
  normalizationVersion String?
  publishable          Boolean              @default(false)
  normalizedPayload    Json
  validationMessages   Json?
  errorMessage         String?
  publishedRecordId    String?
  publishedAt          DateTime?
  importBatch          ImportBatch          @relation("ImportBatchNormalizedRows", fields: [importBatchId], references: [id], onDelete: Cascade)
  importFile           ImportFile           @relation("ImportFileNormalizedRows", fields: [importFileId], references: [id], onDelete: Cascade)
  importRowRaw         ImportRowRaw         @relation(fields: [importRowRawId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importBatchId])
  @@index([status])
  @@index([recordType])
  @@index([rowKind])
  @@index([publishable])
  @@index([dedupeKey])
  @@index([businessKey])
}

model Investor {
  id                   String                @id @default(cuid())
  displayName          String
  normalizedName       String                @unique
  rawAliases           Json?
  operationalSnapshots OperationalSnapshot[]
  users                User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayName])
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  name              String
  role              UserRole   @default(INVESTOR)
  investorId        String?
  active            Boolean    @default(true)
  firstLogin        Boolean    @default(true)
  investor          Investor?  @relation(fields: [investorId], references: [id], onDelete: SetNull)
  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([investorId])
}

model AuditLog {
  id               String  @id @default(cuid())
  action           String
  actorUserId      String?
  actorRole        String?
  targetUserId     String?
  targetInvestorId String?
  metadata         Json?
  ip               String?
  userAgent        String?
  actorUser        User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser       User?   @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
}

model Vehicle {
  id                   String                @id @default(cuid())
  plate                String                @unique
  plateDisplay         String?
  modelLatest          String?
  operationalSnapshots OperationalSnapshot[]
  fineRecords          FineRecord[]
  fineResponsibilities FineResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id                   String                @id @default(cuid())
  displayName          String
  normalizedName       String                @unique
  operationalSnapshots OperationalSnapshot[]
  fineRecords          FineRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayName])
}

model OperationalSnapshot {
  id                        String                  @id @default(cuid())
  sourceFileId              String
  importBatchId             String?
  investorId                String?
  vehicleId                 String?
  driverId                  String?
  rowHash                   String                  @unique
  operationalKey            String
  sheetName                 String
  sourceRowNumber           Int
  referenceDate             DateTime
  referenceYear             Int
  referenceMonth            Int
  weekOfMonth               Int?
  contractActiveRaw         String?
  contractActive            Boolean?
  vehicleStatusRaw          String?
  vehicleStatusNormalized   String?
  paymentStatusRaw          String?
  paymentState              OperationalPaymentState @default(UNKNOWN)
  plateRaw                  String?
  plate                     String
  modelRaw                  String?
  model                     String?
  investorRaw               String?
  investorNormalized        String?
  driverRaw                 String?
  driverNormalized          String?
  contractValue             Decimal?                @db.Decimal(12, 2)
  lateFeeAmount             Decimal?                @db.Decimal(12, 2)
  discountAmount            Decimal?                @db.Decimal(12, 2)
  amountToCharge            Decimal?                @db.Decimal(12, 2)
  maintenanceByDriverAmount Decimal?                @db.Decimal(12, 2)
  amountPaidWeek            Decimal?                @db.Decimal(12, 2)
  openAmount                Decimal?                @db.Decimal(12, 2)
  rawJson                   Json?
  sourceFile                SourceFile              @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  importBatch               ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  investor                  Investor?               @relation(fields: [investorId], references: [id], onDelete: SetNull)
  vehicle                   Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver                    Driver?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceFileId, sheetName, sourceRowNumber])
  @@index([sourceFileId, referenceDate])
  @@index([importBatchId])
  @@index([investorId, referenceDate])
  @@index([vehicleId, referenceDate])
  @@index([driverId, referenceDate])
  @@index([plate, referenceDate])
  @@index([referenceYear, referenceMonth, weekOfMonth])
  @@index([paymentState])
  @@index([operationalKey])
}

model FinancialAccount {
  id               String           @id @default(cuid())
  displayName      String
  normalizedName   String           @unique
  rawAliases       Json?
  financialEntries FinancialEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayName])
}

model FinancialEntry {
  id                 String                  @id @default(cuid())
  sourceFileId       String
  importBatchId      String?
  financialAccountId String?
  rowHash            String                  @unique
  entryKey           String
  sourceSheetName    String
  sourceRowNumber    Int
  domain             FinancialEntryDomain
  direction          FinancialEntryDirection
  entryDate          DateTime
  referenceYear      Int
  referenceMonth     Int
  groupRaw           String?
  groupNormalized    String?
  detailRaw          String?
  categoryRaw        String?
  accountRaw         String?
  amount             Decimal                 @db.Decimal(12, 2)
  rawJson            Json?
  sourceFile         SourceFile              @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  importBatch        ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  financialAccount   FinancialAccount?       @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceFileId, sourceSheetName, sourceRowNumber])
  @@index([domain, entryDate])
  @@index([direction, entryDate])
  @@index([financialAccountId, entryDate])
  @@index([referenceYear, referenceMonth])
  @@index([entryKey])
}

model FineRecord {
  id                  String               @id @default(cuid())
  sourceFileId        String
  importBatchId       String?
  vehicleId           String?
  driverId            String?
  rowHash             String               @unique
  fineKey             String
  sourceSheetName     String
  sourceRowNumber     Int
  infractionDate      DateTime
  referenceYear       Int
  referenceMonth      Int
  issuingAuthorityRaw String?
  driverRaw           String?
  driverNormalized    String?
  paymentStatusRaw    String?
  paymentState        FinePaymentState     @default(UNKNOWN)
  amount              Decimal?             @db.Decimal(12, 2)
  plateRaw            String?
  plate               String
  aitRaw              String?
  ait                 String?
  vehicleRaw          String?
  rawJson             Json?
  sourceFile          SourceFile           @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  importBatch         ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver              Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  responsibilities    FineResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceFileId, sourceSheetName, sourceRowNumber])
  @@index([plate, infractionDate])
  @@index([vehicleId, infractionDate])
  @@index([driverId, infractionDate])
  @@index([ait])
  @@index([paymentState])
  @@index([fineKey])
}

model FineResponsibility {
  id                 String             @id @default(cuid())
  sourceFileId       String
  importBatchId      String?
  fineRecordId       String?
  vehicleId          String?
  rowHash            String             @unique
  responsibilityKey  String
  sourceSheetName    String
  sourceRowNumber    Int
  sectionLabelRaw    String?
  payerContextRaw    String?
  responsibilityType ResponsibilityType @default(UNKNOWN)
  plateRaw           String?
  plate              String?
  infractionDate     DateTime?
  paymentDate        DateTime?
  amount             Decimal?           @db.Decimal(12, 2)
  payeeRaw           String?
  rawJson            Json?
  sourceFile         SourceFile         @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  importBatch        ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  fineRecord         FineRecord?        @relation(fields: [fineRecordId], references: [id], onDelete: SetNull)
  vehicle            Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceFileId, sourceSheetName, sourceRowNumber])
  @@index([plate, paymentDate])
  @@index([fineRecordId])
  @@index([responsibilityType])
  @@index([responsibilityKey])
}
